	if inrange(iintdaty,2000,2020) & inrange(iintdatm,1,12) & ///
	   inrange(preload_y,2000,2020) & inrange(preload_m,1,12) & ///
	   (preload_s == 1 | WpEmp == 1) & !mi(preload)
