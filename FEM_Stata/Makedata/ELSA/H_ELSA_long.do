*wave 6 respondent age want to retire
gen r`wavenum'wretage = .
replace r`wavenum'wretage = .m if inlist(scrtage,-1,-2,-9)
replace r`wavenum'wretage = .d if scrtage==998
replace r`wavenum'wretage = .c if inw`wavenum'sc==0 & inw`wavenum'==1
replace r`wavenum'wretage = .w if scempl==2 | scrtage==996 
replace r`wavenum'wretage = .n if scrtage==997
replace r`wavenum'wretage = .i if inrange(scrtage,0,17) 
replace r`wavenum'wretage = scrtage if inrange(scrtage,18,300)
label variable r`wavenum'wretage "r`wavenum'wretage:w`wavenum' age R wants to retire"

*wave 6 spouse age want to retire
