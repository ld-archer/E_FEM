gen preretrs=.
forvalues w = `pre_wavenum' (-1) 1 {
	replace preretrs = r`w'retrs if inrange(r`w'retrs,1,5) & mi(preretrs) & inw`wavenum'==1
}

recode wpreaoh wprearh wpreare wpreavr wpreafi wpreafa wpreaen wpreach wpreast wpreadt wpreayo wprea95 wprea96 (-9 -8 -1 = .)
egen num_reas_early = rowtotal(wpreaoh wprearh wpreare wpreavr wpreafi wpreafa wpreaen wpreach wpreast wpreadt wpreayo wprea95 wprea96) if inw`wavenum'==1,m
recode wprrag wprroh wprrrh wprrre wprrfi wprrfa wprren wprrch wprrst wprrdt wprryo wprr95 wprr96 (-9 -8 -1 = .)
egen num_reas_ret = rowtotal(wprrag wprroh wprrrh wprrre wprrfi wprrfa wprren wprrch wprrst wprrdt wprryo wprr95 wprr96) if inw`wavenum'==1,m

gen r`wavenum'retrs = .
replace r`wavenum'retrs = .m if WpDes == -1 | WpMRea==-1 | WpMRRe==-1
replace r`wavenum'retrs = .d if WpMRea==-8 | WpMRRe==-8
replace r`wavenum'retrs = .r if WpMRea==-9 | WpMRRe==-9
replace r`wavenum'retrs = .z if WPActW == 4 | inlist(WPActW,1,3) | WpDes == 3 
replace r`wavenum'retrs = 1 if WpMRea==4 | WpMRRe==1   
replace r`wavenum'retrs = 2 if inlist(WpMRea,3,5) | inlist(WpMRRe,4,5)
