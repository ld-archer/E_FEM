	 .d ".d:DK" ///
	 .z ".z:not retired" ///
	 .s ".s:no pension scheme" ///
	 .e ".e:took early retirement" ///
	 .n ".n:had pension scheme" ///
	 .o ".o:retired other reason, not age" 
	 
***Offered Early Retirement***
label define earlyr ///
	0 "0.no" ///
	1 "1.yes" ///
	.e ".e:not an employee" ///
	.s ".s:self-employed" ///
	.a ".a:younger than 50"	

