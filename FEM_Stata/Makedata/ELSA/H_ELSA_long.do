                     disib scchd scchdg scchdh scchdi scfam scfamg scfamh scfami dignmy dignmyc digran ///
					 scfrd scfrdg scfrdh scfrdi askpx hehpa ercamgc ercaa wpactca wpactvw wpactlo dikliv difjob
										 										
