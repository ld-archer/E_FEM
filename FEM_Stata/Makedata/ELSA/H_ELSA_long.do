foreach v of varlist pre_dhr pre_dhr? pre_dhr1? {
	replace `w`pre_wavenum'mishw' = 1 if `v'==1 & inlist(pre_dimar,2,4)
}
replace `w`pre_wavenum'mishw' = 2 if `w`pre_wavenum'mishw'==0 & inlist(pre_dimar,2,4)
