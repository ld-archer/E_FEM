replace r`wavenum'mrct = r`wavenum'mrct + 1 if ( (( (pre_dhr!=1 & dhr==1) | ///
																					   		 (pre_dhr2!=1 & dhr2==1) | ///
																					   		 (pre_dhr3!=1 & dhr3==1) | ///
																					   		 (pre_dhr4!=1 & dhr4==1) | ///
																					   		 (pre_dhr5!=1 & dhr5==1) | ///
																					   		 (pre_dhr6!=1 & dhr6==1) | ///
																					   		 (pre_dhr7!=1 & dhr7==1) | ///
																					   		 (pre_dhr8!=1 & dhr8==1) | ///
																					   		 (pre_dhr9!=1 & dhr9==1) | ///
																					   		 (pre_dhr10!=1 & dhr10==1) | ///
																					   		 (pre_dhr11!=1 & dhr11==1) | ///
																					   		 (pre_dhr12!=1 & dhr12==1) | ///
																					   		 (dhr13==1) | ///
