		replace `result' = 1 if `v' == 1 & (`touse')
		}
	foreach v of varlist `varlist' {
		replace `result' = 2 if `v' == 2 & (`touse')
		}
	foreach v of varlist `varlist' {
		replace `result' = 3 if `v' == 3 & (`touse')
