									  & !mi(h`wavenum'iothr)
replace h`wavenum'itot = r`wavenum'itearn + s`wavenum'itearn + h`wavenum'icap + r`wavenum'itpena /// 
												+ s`wavenum'itpena + r`wavenum'ipubpen + s`wavenum'ipubpen + r`wavenum'igxfr /// 
