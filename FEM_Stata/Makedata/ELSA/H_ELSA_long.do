                     indager exlo90 indsex askpx wpactpw wpactse wpaway wpcret wpcretl ///
                     wpactvw wpactca wpactlo wpacted wpact96 wpes ///
                     wperag wpactw wperet wpearly wpwkr scrtage scempl wpcrage ///
										 wprea* wprr* wpmrea wpmrre 
