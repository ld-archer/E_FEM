gen dkwalk = 0
replace dkwalk = 1 if mmalone==-8 | mmhss==-8 | mmwill==-8 | mmsaf==-8 | mmavsp==-8 | mmwala==-8

gen rfwalk = 0
replace rfwalk = 1 if mmalone==-9 | mmhss==-9 | mmwill==-9 | mmsaf==-9 | mmavsp==-9 | mmwala==-9

gen walkskip = 0
replace walkskip = 1 if inrange(r`wv'agey,1,59) | r`wv'proxy==1

***Walking Speed 1***
*wave 1 respondent walking speed 1
gen r`wv'wspeed1 = .
replace r`wv'wspeed1 = .m if mmwlka==-1
replace r`wv'wspeed1 = .s if walkskip==1
replace r`wv'wspeed1 = .n if nowalk==1
replace r`wv'wspeed1 = .d if dkwalk==1 | mmwlka==-8 
replace r`wv'wspeed1 = .r if rfwalk==1 | mmwlka==-9 | mmtrya==4
replace r`wv'wspeed1 = .x if inlist(mmtrya,2,3)
replace r`wv'wspeed1 = mmwlka if inrange(mmwlka,0,100)
replace r`wv'wspeed1 = .i if inrange(mmwlka,101,997)
label variable r`wv'wspeed1 "r`wv'wspeed1:w`wv' r time for walking speed test 1(sec)"

*wave 1 spouse walking speed 1
gen s`wv'wspeed1 =.
spouse r`wv'wspeed1, result(s`wv'wspeed1) wave(`wv')
label variable s`wv'wspeed1 "s`wv'wspeed1:w`wv' s time for walking speed test 1(sec)"

***Walking Speed 2***
