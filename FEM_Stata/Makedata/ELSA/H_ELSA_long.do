replace r`wavenum'jrsleft = 8 if inlist(wpystpm,2,7,8,10,11,13,14,95) | inlist(wpmrea,5,7,8,11,95,96) | ///
																 inlist(wpmrre,5,7,8,11,95,96)
replace r`wavenum'jrsleft = 1 if mi(r`wavenum'jrsleft) & ((num_reas_early==1 & wpreavr==1) | ///
																													(num_reas_ret==1 & wprrag==1))
replace r`wavenum'jrsleft = 3 if mi(r`wavenum'jrsleft) & ((num_reas_early==1 & wpreare==1) | ///
