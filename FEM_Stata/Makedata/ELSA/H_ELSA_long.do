label values s`wavenum'oeret earlyr

***Age offered early retirement***
*wave 6 respondent age offered early retirement
gen r`wavenum'oeretage = .
replace r`wavenum'oeretage = .m if WpErAg==-1
replace r`wavenum'oeretage = .d if WpErAg==-8 | WpEs==-8 | WpEarly==-8
replace r`wavenum'oeretage = .r if WpErAg==-9 | WpEs==-9 | WpEarly==-9
replace r`wavenum'oeretage = .a if inrange(r`wavenum'agey,0,49)
replace r`wavenum'oeretage = .e if inlist(WPActW,3,4) 
replace r`wavenum'oeretage = .s if WpEs==2 
replace r`wavenum'oeretage = .n if WpEarly==2 
replace r`wavenum'oeretage = WpErAg if inrange(WpErAg,50,65)
