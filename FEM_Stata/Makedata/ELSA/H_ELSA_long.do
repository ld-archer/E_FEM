replace r`wavenum'oeretage = .d if wperag==-8 | wpes==-8 | wpearly==-8
replace r`wavenum'oeretage = .r if wperag==-9 | wpes==-9 | wpearly==-9
replace r`wavenum'oeretage = .a if inrange(r`wavenum'agey,0,49)
