replace s`wavenum'itearn = .v if w`wavenum'spouse == 1 & s`wavenum'idauniq == 0
replace s`wavenum'itearn = s`wavenum'itmain + s`wavenum'itsec if !mi(s`wavenum'itmain) & !mi(s`wavenum'itsec)
