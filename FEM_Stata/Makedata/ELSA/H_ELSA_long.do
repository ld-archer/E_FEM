label variable s`wavenum'earlyret "s`wavenum'earlyret:w`wavenum' S took early retirement"
label values s`wavenum'earlyret retire

drop pre_early

***Had opportunity to work past retirement***
*wave 5 respondent had opportunity to work past retirement
gen r`wavenum'oretwrk = .
missing_w5 wpdes wperet wpreamno wprrmag wprrmre wpwkr, result(r`wavenum'oretwrk)
replace r`wavenum'oretwrk = .z if inlist(wpdes,2,3,4,5,6,85,86,95) /*not retired/semi-retired*/
forvalues w = 1 / `pre_wavenum' {
	replace r`wavenum'oretwrk = r`w'oretwrk if inlist(r`w'oretwrk,0,1,.d,.r,.e,.n,.o) & inlist(wpdes,1,96) 
}
replace r`wavenum'oretwrk = .e if wperet == 1 & wpreamno != 1 /*retired early*/
replace r`wavenum'oretwrk = .o if wprrmag == 0 & wprrmre == 0 /*reason other than age*/
replace r`wavenum'oretwrk = 0 if wpwkr==2 | wprrmre == 1
replace r`wavenum'oretwrk = 1 if wpwkr==1
label variable r`wavenum'oretwrk "r`wavenum'oretwrk:w`wavenum' R had opportunity to work past retirement"
label values r`wavenum'oretwrk retire

*wave 5 spouse had opportunity to work past retirement
gen s`wavenum'oretwrk = .
spouse r`wavenum'oretwrk, result(s`wavenum'oretwrk) wave(`wavenum')
label variable s`wavenum'oretwrk "s`wavenum'oretwrk:w`wavenum' S had opportunity to work past retirement"
