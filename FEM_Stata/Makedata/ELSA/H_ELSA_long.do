label variable s`wavenum'oeretage "s`wavenum'oeretage:w`wavenum' S age offered early retirement"

***Took early retirement***
*wave 6 respondent took early retirement
gen pre_early = .
forvalues w = `pre_wavenum' (-1) 1 {
	replace pre_early = r`w'earlyret if r`w'earlyret!=. & mi(pre_early)
}

gen r`wavenum'earlyret = .
replace r`wavenum'earlyret = .m if WpERet==-1
replace r`wavenum'earlyret = .d if WpERet==-8 | WpDes==-8 
replace r`wavenum'earlyret = .r if WpERet==-9 | WpDes==-9 
replace r`wavenum'earlyret = .z if inlist(WpDes,2,3,4,5,6,85,86,95) 
replace r`wavenum'earlyret = pre_early if inlist(pre_early,0,1,.d,.r,.s) & inlist(WpDes,1,96) & inw`wavenum'==1
replace r`wavenum'earlyret = 0 if WpERet==2
replace r`wavenum'earlyret = 1 if WpERet==1
label variable r`wavenum'earlyret "r`wavenum'earlyret:w`wavenum' R took early retirement"
label values r`wavenum'earlyret retire

*wave 6 spouse took early retirement
gen s`wavenum'earlyret = .
spouse r`wavenum'earlyret, result(s`wavenum'earlyret) wave(`wavenum')
label variable s`wavenum'earlyret "s`wavenum'earlyret:w`wavenum' S took early retirement"
label values s`wavenum'earlyret retire

drop pre_early

***Had opportunity to work past retirement***
*wave 6 respondent had opportunity to work past retirement
gen r`wavenum'oretwrk = .
missing_w6 WpDes WpERet wpreamno wprrmag wprrmre WpWkR, result(r`wavenum'oretwrk)
replace r`wavenum'oretwrk = .z if inlist(WpDes,2,3,4,5,6,85,86,95) /*not retired/semi-retired*/
forvalues w = 1 / `pre_wavenum' {
	replace r`wavenum'oretwrk = r`w'oretwrk if inlist(r`w'oretwrk,0,1,.d,.r,.e,.n,.o) & inlist(WpDes,1,96) 
}
replace r`wavenum'oretwrk = .e if WpERet == 1 & wpreamno != 1 /*retired early*/
replace r`wavenum'oretwrk = .o if wprrmag == 0 & wprrmre == 0 /*reason other than age*/
replace r`wavenum'oretwrk = 0 if WpWkR==2 | wprrmre == 1
replace r`wavenum'oretwrk = 1 if WpWkR==1
label variable r`wavenum'oretwrk "r`wavenum'oretwrk:w`wavenum' R had opportunity to work past retirement"
label values r`wavenum'oretwrk retire

*wave 6 spouse had opportunity to work past retirement
gen s`wavenum'oretwrk = .
spouse r`wavenum'oretwrk, result(s`wavenum'oretwrk) wave(`wavenum')
label variable s`wavenum'oretwrk "s`wavenum'oretwrk:w`wavenum' S had opportunity to work past retirement"
label values s`wavenum'oretwrk retire

***Prefer to work after Retirement***
*wave 6 respondent prefer to work after retirement
gen r`wavenum'pretwrk = .
missing_w6 WpEs WPCRet WPActW WPCRetL, result(r`wavenum'pretwrk)
replace r`wavenum'pretwrk = .e if WPCRetL == -1 & inlist(WPActW,3,4)
replace r`wavenum'pretwrk = .s if WPCRetL == -1 & WpEs == 2
replace r`wavenum'pretwrk = .a if WPCRetL == -1 & WPCRet == 2
replace r`wavenum'pretwrk = 0 if WPCRetL == 2
replace r`wavenum'pretwrk = 1 if WPCRetL == 1
label variable r`wavenum'pretwrk "r`wavenum'pretwkr:w`wavenum' R Prefer to work after compulsory retirement"
label values r`wavenum'pretwrk pworkret

*wave 6 spouse prefer to work after retirement
gen s`wavenum'pretwrk = .
spouse r`wavenum'pretwrk, result(s`wavenum'pretwrk) wave(`wavenum')
label variable s`wavenum'pretwrk "s`wavenum'pretwrk:w`wavenum' S Prefer to work after compulsory retirement"
label values s`wavenum'pretwrk pworkret

***Reasons for retiring***
*wave 6 respondent reasons for retiring
gen preretrs=.
forvalues w = `pre_wavenum' (-1) 1 {
	replace preretrs = r`w'retrs if inrange(r`w'retrs,1,5) & mi(preretrs) & inw`wavenum'==1
}

recode wpreaoh wprearh wpreare wpreavr wpreafi wpreafa wpreaen wpreach wpreast wpreadt wpreayo wprea95 wprea96 (-9 -8 -1 = .)
egen num_reas_early = rowtotal(wpreaoh wprearh wpreare wpreavr wpreafi wpreafa wpreaen wpreach wpreast wpreadt wpreayo wprea95 wprea96) if inw`wavenum'==1,m
recode wprrag wprroh wprrrh wprrre wprrfi wprrfa wprren wprrch wprrst wprrdt wprryo wprr95 wprr96 (-9 -8 -1 = .)
egen num_reas_ret = rowtotal(wprrag wprroh wprrrh wprrre wprrfi wprrfa wprren wprrch wprrst wprrdt wprryo wprr95 wprr96) if inw`wavenum'==1,m

gen r`wavenum'retrs = .
replace r`wavenum'retrs = .m if WpDes == -1 | WpMRea==-1 | WpMRRe==-1
replace r`wavenum'retrs = .d if WpMRea==-8 | WpMRRe==-8
replace r`wavenum'retrs = .r if WpMRea==-9 | WpMRRe==-9
replace r`wavenum'retrs = .z if WPActW == 4 | inlist(WPActW,1,3) | WpDes == 3 
replace r`wavenum'retrs = 1 if WpMRea==4 | WpMRRe==1   
replace r`wavenum'retrs = 2 if inlist(WpMRea,3,5) | inlist(WpMRRe,4,5)
replace r`wavenum'retrs = 3 if WpMRea==1 | WpMRRe==2
replace r`wavenum'retrs = 4 if inlist(WpMRea,2,6,9,10) | inlist(WpMRRe,3,6,9,10)
replace r`wavenum'retrs = 5 if inlist(WpMRea,7,8,11,95,96) | inlist(WpMRRe,7,8,11,95,96)
replace r`wavenum'retrs = 1 if mi(r`wavenum'retrs) & ((num_reas_early==1 & wpreavr==1) | (num_reas_ret==1 & wprrag==1))
replace r`wavenum'retrs = 2 if mi(r`wavenum'retrs) & ((num_reas_early==1 & (wpreare==1 | wpreafi==1)) | ///
																											(num_reas_ret==1 & (wprrrh==1 | wprrfi==1)))
replace r`wavenum'retrs = 3 if mi(r`wavenum'retrs) & ((num_reas_early==1 & wpreaoh==1) | (num_reas_ret==1 & wprroh==1))
