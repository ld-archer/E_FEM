		r`wavenum'igxfr==.t | s`wavenum'igxfr==.t | h`wavenum'iothr==.t
replace h`wavenum'itot = .u if w`wavenum'spouse == 0 & s`wavenum'idauniq == 0
replace h`wavenum'itot = .v if w`wavenum'spouse == 1 & s`wavenum'idauniq == 0
