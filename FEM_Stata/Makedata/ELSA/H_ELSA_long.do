***Offered early retirement***
*wave 6 respondent offered early retirement
gen r`wavenum'oeret = .
replace r`wavenum'oeret = .m if WpEarly==-1
replace r`wavenum'oeret = .d if WpEarly==-8 | WpEs==-8
replace r`wavenum'oeret = .r if WpEarly==-9 | WpEs==-9
replace r`wavenum'oeret = .a if inrange(r`wavenum'agey,0,49)
replace r`wavenum'oeret = .e if inlist(WPActW,3,4)
replace r`wavenum'oeret = .s if WpEs==2
replace r`wavenum'oeret = 0 if WpEarly==2
replace r`wavenum'oeret = 1 if WpEarly==1
label variable r`wavenum'oeret "r`wavenum'oeret:w`wavenum' R offered early retirement"
label values r`wavenum'oeret earlyr

