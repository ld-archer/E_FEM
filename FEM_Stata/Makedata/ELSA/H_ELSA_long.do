																													(num_reas_ret==1 & wprroh==1))
replace r`wavenum'jrsleft = 5 if mi(r`wavenum'jrsleft) & ((num_reas_early==1 & (wprearh==1 | wpreafa==1 | wpreast==1 | wpreadt==1)) | ///
																													(num_reas_ret==1 & (wprrrh==1 | wprrfa==1 | wprrst==1 | wprrdt==1)))
replace r`wavenum'jrsleft = 8 if mi(r`wavenum'jrsleft) & ((num_reas_early==1 & (wpreafi==1 | wpreaen==1 | wpreach==1 | wpreayo==1 | wprea95==1 | wprea96==1)) | ///
																													(num_reas_ret==1 & (wprrfi==1 | wprren==1 | wprrch==1 | wprryo==1 | wprr95==1 | wprr96==1)))
replace r`wavenum'jrsleft = prejrsleft if mi(r`wavenum'jrsleft) & inrange(prejrsleft,1,8)
