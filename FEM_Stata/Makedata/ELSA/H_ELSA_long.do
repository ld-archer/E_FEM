****amount helpers are paid***
**intermediate variables for calculation of amount paid by helper*
*first helper - arranged by local authority*
recode caarr01 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_26)
recode caarr02 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_27)
recode caarr03 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_28)
recode caarr04 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_36)
recode caarr05 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_29)
recode caarr06 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_30)
recode caarr07 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_31)
recode caarr08 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_32)
recode caarr09 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_33)
recode caarr10 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_34)
recode caarr11 (-9 -8 -2 -1 1 4 = 0) (2 3 = 1), gen(caarr_35)

egen localauth = rowtotal(caarr_26 caarr_27 caarr_28 caarr_29 caarr_30 caarr_31 caarr_32 caarr_33 caarr_34 caarr_35 caarr_36),m

gen hr1 = .
forvalues c = 26/35 {
	replace hr1 = cahrf`c' if inrange(cahrf`c',0,168) & caarr_`c'==1 & localauth==1
}

recode cahpf  (-9 -8 -1=.) (1=30) (2=21.5) (3=10.75) (4=4.3) (5=2.15) (6=1) (7=0), gen(CAhpf1)
recode cahpf2 (-9 -8 -1=.) (1=30) (2=21.5) (3=10.75) (4=4.3) (5=2.15) (6=1) (7=0), gen(CAhpf2)

gen day1 = .
forvalues c = 26/35 {
	replace day1 = CAhpf1 if inrange(CAhpf1,0,30) & cafnd1==`c' & caarr_`c'==1 & localauth==1
	replace day1 = CAhpf2 if inrange(CAhpf2,0,30) & cafnd2==`c' & caarr_`c'==1 & localauth==1
}

gen amt1 = .
replace amt1 = capam/12      if capfq==8 & inrange(capam,1,10000) //per year
replace amt1 = capam 			   if capfq==7 & inrange(capam,1,10000) //per month
replace amt1 = capam*1.075   if capfq==6 & inrange(capam,1,10000) //per 4 weeks
replace amt1 = capam*2.15    if capfq==5 & inrange(capam,1,10000) //per fortnight
replace amt1 = capam*4.3     if capfq==4 & inrange(capam,1,10000) //per week
replace amt1 = capam*day1    if inlist(capfq,2,3) & inrange(capam,1,10000) //per day/visit
replace amt1 = capam*hr1*4.3 if capfq==1 & inrange(capam,1,10000) //per hour/wk

*second helper*
gen hr2 = .
forvalues c = 1/25 {
	replace hr2 = cahri_`c' if inrange(cahri_`c',0,168) & caask1==`c' & inrange(caask1,1,25)
}
forvalues c = 26/35 {
	replace hr2 = cahrf`c' if inrange(cahrf`c',0,168) & caask1==`c' & inrange(caask1,26,35)
}

gen day2 = .
forvalues c = 1/35 {
	replace day2 = CAhpf1 if inrange(CAhpf1,0,30) & caask1==`c' & cafnd1==`c' & inrange(caask1,1,35)
	replace day2 = CAhpf2 if inrange(CAhpf2,0,30) & caask1==`c' & cafnd2==`c' & inrange(caask1,1,35)
}

gen amt2 = .
replace amt2 = capam2/12      if capfq2==8 & inrange(capam2,1,10000) //per year
replace amt2 = capam2 			  if capfq2==7 & inrange(capam2,1,10000) //per month
replace amt2 = capam2*1.075   if capfq2==6 & inrange(capam2,1,10000) //per 4 weeks
replace amt2 = capam2*2.15    if capfq2==5 & inrange(capam2,1,10000) //per fortnight
replace amt2 = capam2*4.3     if capfq2==4 & inrange(capam2,1,10000) //per week
replace amt2 = capam2*day2    if inlist(capfq2,2,3) & inrange(capam2,1,10000) //per day/visit
replace amt2 = capam2*hr2*4.3 if capfq2==1 & inrange(capam2,1,10000) //per hour/wk

*third helper*
gen hr3 = .
forvalues c = 1/25 {
	replace hr3 = cahri_`c' if inrange(cahri_`c',0,168) & caask2==`c' & inrange(caask2,1,25)
}
forvalues c = 26/35 {
	replace hr3 = cahrf`c' if inrange(cahrf`c',0,168) & caask2==`c' & inrange(caask2,26,35)
}

gen day3 = .
forvalues c = 1/35 {
	replace day3 = CAhpf1 if inrange(CAhpf1,0,30) & caask2==`c' & cafnd1==`c' & inrange(caask1,1,35)
	replace day3 = CAhpf2 if inrange(CAhpf2,0,30) & caask2==`c' & cafnd2==`c' & inrange(caask1,1,35)
}

gen amt3 = .
replace amt3 = capam3/12      if capfq3==8 & inrange(capam3,1,10000) //per year
replace amt3 = capam3 			  if capfq3==7 & inrange(capam3,1,10000) //per month
replace amt3 = capam3*1.075   if capfq3==6 & inrange(capam3,1,10000) //per 4 weeks
replace amt3 = capam3*2.15    if capfq3==5 & inrange(capam3,1,10000) //per fortnight
replace amt3 = capam3*4.3     if capfq3==4 & inrange(capam3,1,10000) //per week
replace amt3 = capam2*day3    if inlist(capfq3,2,3) & inrange(capam3,1,10000) //per day/visit
replace amt3 = capam3*hr3*4.3 if capfq3==1 & inrange(capam3,1,10000) //per hour/wk

gen nmamt = 0 if inlist(r`wv'hlppdn_e,1,2)
replace nmamt = 1 if !mi(amt1) | !mi(amt2) | !mi(amt3)

*wave 9 respondent amount helpers are paid
gen r`wv'hlppdamt_e = .
missing_w`wv' r`wv'hlppdn_e caask1 caask2 capfq capfq2 capfq3 capam capam2 capam3, result(r`wv'hlppdamt_e)
replace r`wv'hlppdamt_e = .x if noprob==1
replace r`wv'hlppdamt_e = .n if askinst==1
replace r`wv'hlppdamt_e = .h if r`wv'rcany_e==0
replace r`wv'hlppdamt_e = .b if catch==2
replace r`wv'hlppdamt_e = .o if (inlist(capfq,1,2,3) & mi(amt1)) | (inlist(capfq2,2,3) & mi(amt2)) | ///
																(inlist(capfq3,2,3) & mi(amt3))
replace r`wv'hlppdamt_e = 0 if r`wv'hlppdn_e==0 | nmamt==1
replace r`wv'hlppdamt_e = r`wv'hlppdamt_e + amt1 if inrange(amt1,1,10000)
replace r`wv'hlppdamt_e = r`wv'hlppdamt_e + amt2 if inrange(amt2,1,10000)
replace r`wv'hlppdamt_e = r`wv'hlppdamt_e + amt3 if inrange(amt3,1,10000)
label variable r`wv'hlppdamt_e "r`wv'hlppdamt_e:w`wv' r oop cost for help for adls/iadls/mobility"

*wave 9 spouse amount helpers are paid
gen s`wv'hlppdamt_e = .
spouse r`wv'hlppdamt_e, result(s`wv'hlppdamt_e) wave(`wv')
label variable s`wv'hlppdamt_e "s`wv'hlppdamt_e:w`wv' s oop cost for help for adls/iadls/mobility"


